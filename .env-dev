# === Database ===
POSTGRES_USER=api
POSTGRES_PASSWORD=root
POSTGRES_DB=api
POSTGRES_HOST=database

# === Git ===
GIT_BRANCH=develop

# === Application ===
PRODUCTION=false
DELETE_NODE_MODULES=true

# === DB Server Limits ===
DB_SERVER_MEMORY_LIMIT=4G
DB_SERVER_CPU_LIMIT=2

# === API Server Limits ===
API_SERVER_MEMORY_LIMIT=2G
API_SERVER_CPU_LIMIT=2
API_SERVER_PORT=8000

# === Sync Server Limits ===
SYNC_SERVER_MEMORY_LIMIT=2G
SYNC_SERVER_CPU_LIMIT=2

# === Metamodeling React Client Limits ===
METAMODELING_REACT_CLIENT_MEMORY_LIMIT=6G
METAMODELING_REACT_CLIENT_CPU_LIMIT=2

# === Modeling React Client Limits ===
MODELING_REACT_CLIENT_MEMORY_LIMIT=6G
MODELING_REACT_CLIENT_CPU_LIMIT=2
