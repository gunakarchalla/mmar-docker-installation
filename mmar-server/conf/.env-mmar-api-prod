# -----------------------------------------------------------------------------
# MMAR API server configuration - PRODUCTION
#
# Copied to mmar-server/.env by npm-installation-server.sh when the container is
# started with PRODUCTION=true, i.e. "docker compose --env-file .env up".
#
# Reference: .env.example in the mmar-server repository.
#
# The server validates this file while it starts and refuses to boot on a bad
# configuration, rather than failing later on a request.
# -----------------------------------------------------------------------------

# --- Mandatory ---------------------------------------------------------------

# !! CHANGE THIS BEFORE YOU EXPOSE THIS DEPLOYMENT TO ANYONE ELSE !!
# The value below is committed to this public repository, so it has to be
# considered known to everyone. Forging a token with it grants every permission
# the platform has. Generate your own with:
#   openssl rand -base64 48
# At least 32 characters; the server will not start with a shorter one.
# mmar-sync-server verifies those tokens locally, so whatever you put here must
# be copied byte-identically into
# mmar-sync-server/conf/.env-mmar-sync-server-prod.
JWT_SECRET=BnvaotQABBmKJHfEq++tHqV//YmEZXR+Uz2Rrp3WVe80FX9IOfeK0N11rGQfxla5

# Password of the database role the server connects as. Must match
# POSTGRES_PASSWORD in the root .env file; change both together.
PGPASSWORD=root

# --- Database ----------------------------------------------------------------
# The defaults match the "database" service in docker-compose.yml. PGHOST is the
# compose service name, not localhost: the server reaches the database over the
# compose network.

PGHOST=database
PGPORT=5432
PGUSER=api
PGDATABASE=api

# Connections held open by this process. One request uses one connection, so
# this only has to cover the requests in flight, and it must stay well below the
# database's own max_connections (100 by default) across all server instances.
PGPOOL_MAX=25
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECT_TIMEOUT_MS=10000

# Upper bound on a single query, so a runaway statement cannot pin a connection.
PG_STATEMENT_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=30000

# --- HTTP --------------------------------------------------------------------

# Must match API_SERVER_PORT in the root .env file, which is the port
# docker-compose.yml publishes for this container.
HTTPPORT=8000

# "development" enables verbose logging. Anything else, including unset, is
# treated as a production deployment.
NODE_ENV=production

# Browser origins allowed to call the API, comma separated. The API accepts
# cookie authentication, so this cannot be left open to every origin: left
# empty, any origin may call the API but credentials are refused. The list below
# is every client port published by docker-compose.yml, which is what a
# production stack exposed on localhost needs. When you deploy behind a domain,
# replace these with the https origins the clients are actually served from.
CORS_ORIGINS=http://localhost:8070,http://localhost:8075,http://localhost:8080,http://localhost:8085,http://localhost:8090,http://localhost:8095

# Base url used to build the links returned for uploaded files. Falls back to
# the host of the incoming request when unset. Set this when the server sits
# behind a reverse proxy, so uploaded files come back with reachable links.
# PUBLIC_BASE_URL=https://mmar.example.org

# --- Tokens ------------------------------------------------------------------

# Lifetime of an issued token, in the notation accepted by jsonwebtoken
# ("30m", "8h", "7d") or a plain number of seconds. There is no revocation list,
# so this is also how long a leaked token stays usable.
TOKEN_EXPIRE_TIME=8h

# --- Audit -------------------------------------------------------------------

# Record successful token verifications in logging.t_security_event. That is one
# insert per authenticated API call, so it is off unless explicitly enabled.
# Sign ins, rejections and privilege changes are always recorded.
SECURITY_AUDIT_PERSIST_TOKEN_SUCCESS=false
