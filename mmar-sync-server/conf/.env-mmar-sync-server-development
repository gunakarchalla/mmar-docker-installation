# -----------------------------------------------------------------------------
# MMAR sync server configuration - DEVELOPMENT
#
# Copied to mmar-sync-server/.env by npm-installation-sync-server.sh when the
# container is started with PRODUCTION=false, i.e.
# "docker compose --env-file .env-dev up".
#
# Reference: .env.example in the mmar-sync-server repository.
# -----------------------------------------------------------------------------

# Port the websocket server listens on. Must match the port published for the
# mmar-sync-server service in docker-compose.yml.
PORT=8060

# The sync server verifies the tokens issued by mmar-server locally instead of
# calling back for every message, so this must be byte-identical to JWT_SECRET
# in mmar-server/conf/.env-mmar-api-development. A mismatch shows up as clients
# being disconnected with code 4401 (bad-jwt).
JWT_SECRET=BnvaotQABBmKJHfEq++tHqV//YmEZXR+Uz2Rrp3WVe80FX9IOfeK0N11rGQfxla5

# The API the sync server asks for a caller's access level on a scene instance.
# This is the docker-compose service name, not localhost: the request travels
# over the compose network, not through the published port.
API_URL=http://mmar-server:8000

# How often the access is checked for a user
ACCESS_REVALIDATE_INTERVAL_MS=15000